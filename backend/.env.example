# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nextalk

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-64-char-random-access-secret-here
JWT_REFRESH_SECRET=your-64-char-random-refresh-secret-here

# S3 / MinIO
AWS_BUCKET_NAME=nextalk-media
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:9000

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=your-ai-service-secret

# Face Encryption
FACE_ENCRYPTION_KEY=your-aes-256-key-base64-here

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@nextalk.app
