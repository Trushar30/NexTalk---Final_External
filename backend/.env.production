# ─── NexTalk Backend — Production Environment Template ───
# Copy this to .env and fill in real values.
# NEVER commit the actual .env file with secrets.

# App
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-app.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Upstash Redis (use rediss:// for TLS)
REDIS_URL=rediss://default:<password>@<host>:<port>

# JWT (generate strong random strings, min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI Service (set to your Render AI service URL)
AI_SERVICE_URL=https://nextalk-ai.onrender.com
AI_SERVICE_SECRET=

# Face Encryption
FACE_ENCRYPTION_KEY=

# Keep-Alive (set to your own Render backend URL)
KEEP_ALIVE_URL=https://nextalk-backend.onrender.com
AI_KEEP_ALIVE_URL=https://nextalk-ai.onrender.com

# Optional: S3 storage (leave empty if not using)
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT=

# Optional: Push notifications
FCM_SERVER_KEY=

# Optional: Email
SENDGRID_API_KEY=
EMAIL_FROM=noreply@nextalk.app
